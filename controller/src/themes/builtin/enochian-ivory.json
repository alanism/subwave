{
  "id": "enochian-ivory",
  "name": "Enochian Ivory",
  "description": "Original Enochian atlas ivory palette; authored controls and IBM Plex typography.",
  "mode": "light",
  "tokens": {
    "--bg": "#ffffff",
    "--surface": "#f5f5f6",
    "--surface-border": "#dcdcdf",
    "--field": "#f5f5f6",
    "--ink": "#111111",
    "--muted": "#65656a",
    "--ink-faint": "#76776f",
    "--accent": "#cc0000",
    "--accent-2": "#cc0000",
    "--accent-soft": "color-mix(in srgb, #cc0000 12%, #ffffff)",
    "--line": "#dcdcdf",
    "--soft-border": "#dcdcdf",
    "--overlay": "rgba(0,0,0,0.12)",
    "--display-font": "space-grotesk",
    "--mono-font": "ibm-plex-mono",
    "--grain": "0"
  }
}
