{
  "name": "subwave-desktop-enochian",
  "productName": "Subwave",
  "desktopName": "subwave.desktop",
  "version": "1.4.0",
  "description": "Subwave Linux desktop player \u2014 Original and Enochian",
  "author": "Subwave contributors",
  "license": "MIT",
  "main": "src/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "prepare:service": "node scripts/build-service.cjs",
    "prepare:web": "node scripts/prepare-web.cjs",
    "build": "npm run prepare:service && npm run prepare:web && electron-builder --linux AppImage tar.gz --x64 && node scripts/create-launcher.cjs",
    "pack": "npm run prepare:service && npm run prepare:web && electron-builder --linux --dir --x64",
    "lint": "node scripts/check.cjs",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "zod": "4.6.5"
  },
  "build": {
    "appId": "com.subwave.enochian",
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ],
    "linux": {
      "executableName": "subwave",
      "syncDesktopName": true,
      "category": "AudioVideo;Audio;Player",
      "icon": "assets/icon.png",
      "artifactName": "Subwave-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Subwave",
          "Comment": "Original and Enochian radio player",
          "StartupWMClass": "subwave"
        }
      }
    }
  }
}
